# Pinned agent CLI versions. Every entry has a VERSION, URL, and SHA256.
# URLs are fully expanded (no shell variables) so the file parses identically
# in shell, Nix, and any other tool. Keep URL and VERSION in sync by hand --
# a bump is a three-line diff per tool.
#
# To bump a tool:
#   1. Find the new version's release asset URL.
#   2. Run:  nix-prefetch-url --type sha256 <url>
#   3. Convert Nix's base32 output to hex:
#      nix-hash --type sha256 --to-base16 <base32-hash>
#   4. Update VERSION, URL, and SHA256 for that tool, then rerun sandbot-build.
#
# Source of truth for versions last reviewed: 2026-04-22.

# openai/codex  -- Rust CLI, prebuilt glibc Linux tarball.
CODEX_VERSION="0.122.0"
CODEX_URL="https://github.com/openai/codex/releases/download/rust-v0.122.0/codex-x86_64-unknown-linux-gnu.tar.gz"
CODEX_SHA256="8779f387f16ed8899180e9fc15f0fde1d5dc7ce5857d2f79226a22e9453267a2"

# sst/opencode  -- glibc Linux build (not the baseline or musl variants).
OPENCODE_VERSION="1.14.20"
OPENCODE_URL="https://github.com/sst/opencode/releases/download/v1.14.20/opencode-linux-x64.tar.gz"
OPENCODE_SHA256="1707133022382ea8c8cc5bc47ab1db52fa206bd9baf8d3ad4d862b489dbb448f"

# google-gemini/gemini-cli  -- Node bundle; invoked via `node gemini.js`.
GEMINI_CLI_VERSION="0.38.2"
GEMINI_CLI_URL="https://github.com/google-gemini/gemini-cli/releases/download/v0.38.2/gemini-cli-bundle.zip"
GEMINI_CLI_SHA256="19c45c4e7087c81fe3818808433114d6001af1dbc46c158a4c2bcc8bb587c956"

# anthropics/claude-code  -- pull the platform-native package directly rather
# than the wrapper. The wrapper's postinstall selects and copies the same
# linux-x64 binary.
CLAUDE_CODE_VERSION="2.1.117"
CLAUDE_CODE_URL="https://registry.npmjs.org/@anthropic-ai/claude-code-linux-x64/-/claude-code-linux-x64-2.1.117.tgz"
CLAUDE_CODE_SHA256="f01a62806aa4dd02d728463fbe3237517c8b6fe98f640e62c5dd59b48a68eaa1"

# Debian base image  -- pinned by manifest digest.
# Refresh with:
#   podman pull debian:trixie-slim && \
#     podman image inspect --format '{{.Digest}}' debian:trixie-slim
# (Digest captured 2026-04-22.)
DEBIAN_BASE="debian:trixie-slim@sha256:cedb1ef40439206b673ee8b33a46a03a0c9fa90bf3732f54704f99cb061d2c5a"
